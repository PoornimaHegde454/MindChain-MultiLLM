        # - Technical tasks: Prefer larger models for better reasoning
        # - Creative tasks: Prefer versatile models with good language capabilities
        self.routing_rules = {
            # Coding tasks
            ("coding", "low"): "gpt-oss-20b",  # Fast, efficient for simple coding
            ("coding", "medium"): "mixtral-8x7b",  # Excellent for coding tasks
